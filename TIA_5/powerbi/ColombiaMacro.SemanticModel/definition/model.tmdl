model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode"]

annotation PBI_QueryOrder = ["DimDate","DimSeries","FactMetricLong","FactMonthly","MissingDataSummary","_Measures","DataFolder"]

ref table DimDate
ref table DimSeries
ref table FactMetricLong
ref table FactMonthly
ref table MissingDataSummary
ref table _Measures

ref cultureInfo en-US

