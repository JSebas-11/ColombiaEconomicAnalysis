	partition FactMetricLong = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "fact_metric_long.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"Date", type date}, {"SeriesKey", type text}, {"Value", type number}, {"IsOutlier", Int64.Type}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table

