table FactMetricLong
	lineageTag: 3c0cf975-a5b2-4564-b4b0-0f906f02ab6b

	column Date
		dataType: dateTime
		isHidden
		formatString: yyyy-mm-dd
		lineageTag: 1b1a0c10-1174-4b59-92a2-594b0882d66a
		summarizeBy: none
		sourceColumn: Date

		annotation UnderlyingDateTimeDataType = Date

	column SeriesKey
		dataType: string
		isHidden
		lineageTag: d44e95e6-5285-4813-bb3b-d6649678df4a
		summarizeBy: none
		sourceColumn: SeriesKey

	column Value
		dataType: double
		formatString: #,0.00
