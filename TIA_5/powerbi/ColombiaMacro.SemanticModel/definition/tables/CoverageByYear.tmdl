table CoverageByYear
	lineageTag: 5f155885-85c6-4838-9f37-a87897ce0b0d

	column SeriesKey
		dataType: string
		isHidden
		lineageTag: 170c7c61-36d0-4f93-b04a-99a72888c2ad
		summarizeBy: none
		sourceColumn: SeriesKey

	column Year
		dataType: int64
		formatString: 0
		lineageTag: f8539637-5a6b-4ca3-8ad3-4f74f68f76c2
		summarizeBy: none
		sourceColumn: Year

	column ExpectedPeriods
		dataType: int64
		formatString: 0
		lineageTag: 77135f1c-097d-4d37-9485-896bb69a2c16
		summarizeBy: sum
		sourceColumn: ExpectedPeriods

	column ObservedPeriods
		dataType: int64
		formatString: 0
		lineageTag: 11154ed3-cdb2-44b6-a878-fe449161a1b6
		summarizeBy: sum
		sourceColumn: ObservedPeriods

	column CoveragePercent
		dataType: double
		formatString: 0
		lineageTag: 3a89f07c-7d84-4503-8174-cc28f27f9149
		summarizeBy: sum
		sourceColumn: CoveragePercent

	column InAnalysisWindow
		dataType: int64
		formatString: 0
		lineageTag: 6508f3e5-3cb5-4007-9c90-dbc1249501b8
		summarizeBy: none
		sourceColumn: InAnalysisWindow

	partition CoverageByYear = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "coverage_by_year.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"SeriesKey", type text}, {"Year", Int64.Type}, {"ExpectedPeriods", Int64.Type}, {"ObservedPeriods", Int64.Type}, {"CoveragePercent", type number}, {"InAnalysisWindow", Int64.Type}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table

