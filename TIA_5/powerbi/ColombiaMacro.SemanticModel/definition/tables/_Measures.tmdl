	measure 'Inflation Start' = CALCULATE ( [Inflation YoY], FIRSTDATE ( DimDate[Date] ) )
		formatString: 0.00\%
		displayFolder: Terms
		lineageTag: 791a344f-2b0c-454d-8b81-89aa59b202a2

	measure 'Inflation End' = CALCULATE ( [Inflation YoY], LASTDATE ( DimDate[Date] ) )
		formatString: 0.00\%
		displayFolder: Terms
		lineageTag: 2fd7fcea-b354-47fc-b0db-ab12d838bc35

	measure 'Policy Rate Start' = CALCULATE ( [Policy Rate], FIRSTDATE ( DimDate[Date] ) )
		formatString: 0.00\%
		displayFolder: Terms
		lineageTag: 177a42ae-0cc3-4107-a90e-2f8941c7d8fa

	measure 'Policy Rate End' = CALCULATE ( [Policy Rate], LASTDATE ( DimDate[Date] ) )
		formatString: 0.00\%
		displayFolder: Terms
		lineageTag: 92880da9-6a65-4cfd-89f6-b65cdcf64d12

	measure 'TRM Start' = CALCULATE ( [TRM], FIRSTDATE ( DimDate[Date] ) )
		formatString: #,0.00
		displayFolder: Terms
		lineageTag: 4086c31a-a401-44c7-aa59-7d42ee195666

	measure 'TRM End' = CALCULATE ( [TRM], LASTDATE ( DimDate[Date] ) )
		formatString: #,0.00
		displayFolder: Terms
		lineageTag: 0caf521d-50de-438f-a516-96fd384abb35

	measure 'TRM Change %' = DIVIDE ( [TRM End], [TRM Start] ) - 1
		formatString: 0.0%
		displayFolder: Terms
		lineageTag: 52fc5ef6-0aeb-4516-bdd6-2a4f10691aec

	measure 'COLCAP Start' = CALCULATE ( [COLCAP], FIRSTDATE ( DimDate[Date] ) )
		formatString: #,0.00
		displayFolder: Terms
		lineageTag: c18d6b0b-2ca1-4f97-a195-f559034e784c

	measure 'COLCAP End' = CALCULATE ( [COLCAP], LASTDATE ( DimDate[Date] ) )
		formatString: #,0.00
		displayFolder: Terms
		lineageTag: c009344f-7078-4b43-af22-2c8844bcb51b

	measure 'COLCAP Change %' = DIVIDE ( [COLCAP End], [COLCAP Start] ) - 1
		formatString: 0.0%
		displayFolder: Terms
		lineageTag: f9630e9f-d3b3-43fe-8a4c-0703d4148c1b

	measure 'Coverage %' = SUM ( CoverageByYear[CoveragePercent] )
		formatString: 0
		displayFolder: Statistics

	measure 'Empty Cells' = SUM ( MissingDataSummary[EmptyInWindow] ) + 0
		formatString: 0
		displayFolder: Statistics

	measure 'Real Rate Color' = IF ( [Real Policy Rate] < 0, "#e34948", "#2a78d6" )
		displayFolder: Colors

	measure 'Return Color' = VAR r = [COLCAP Monthly Return] RETURN IF ( r < -11.92 || r > 13.45, "#0b0b0b", "#6250d6" )
		displayFolder: Colors

	measure 'Outlier Color' = IF ( [Outliers] > 0, "#0b0b0b", SWITCH ( SELECTEDVALUE ( DimSeries[SeriesKey] ), "Inflation YoY", "#eb6834", "Policy Rate", "#2a78d6", "TRM", "#008300", "COLCAP", "#6250d6", "COLCAP Monthly Return", "#6250d6", "Unemployment Rate", "#e34948", "Occupation Rate", "#e87ba4", "Real GDP Growth", "#1baf7a", "#52514e" ) )
		displayFolder: Colors

	measure 'Coverage Color' = VAR c = [Coverage %] RETURN SWITCH ( TRUE (), ISBLANK ( c ), BLANK (), c >= 100, "#2a78d6", c >= 50, "#7fb0e8", c > 0, "#cfe1f7", "#ffffff" )
		displayFolder: Colors

	measure 'Coverage Font Color' = IF ( [Coverage %] >= 100, "#ffffff", "#0b0b0b" )
		displayFolder: Colors

	column Placeholder
		dataType: string
		isHidden
		lineageTag: 1082c472-0b4e-462f-8aa1-29021e2140b7
		summarizeBy: none
		sourceColumn: Placeholder

	partition _Measures = m
		mode: import
		source = #table(type table [Placeholder = text], {})

	annotation PBI_ResultType = Table

