	measure 'GDP Growth Latest' = CALCULATE ( [GDP Growth], LASTNONBLANK ( DimDate[Date], CALCULATE ( COUNTROWS ( FactQuarterly ) ) ) )
		formatString: 0.00\%
		displayFolder: KPI Cards
		lineageTag: bc030e1a-d681-4737-a060-03d930a8b35b

	measure 'Inflation Window Avg' = CALCULATE ( [Inflation YoY], ALL ( DimDate ) )
		formatString: 0.00\%
		displayFolder: KPI Cards
		lineageTag: d0cc84c7-ee90-40b5-8eb1-1925afb12e16

	measure 'Policy Rate Window Avg' = CALCULATE ( [Policy Rate], ALL ( DimDate ) )
		formatString: 0.00\%
		displayFolder: KPI Cards
		lineageTag: 4c109811-4570-4548-b005-ca7a6c1b7032

	measure 'TRM Window Avg' = CALCULATE ( [TRM], ALL ( DimDate ) )
		formatString: #,0.00
		displayFolder: KPI Cards
		lineageTag: 1a8bb81f-177a-4545-9946-1edc154c81fc

	measure 'COLCAP Window Avg' = CALCULATE ( [COLCAP], ALL ( DimDate ) )
		formatString: #,0.00
		displayFolder: KPI Cards
