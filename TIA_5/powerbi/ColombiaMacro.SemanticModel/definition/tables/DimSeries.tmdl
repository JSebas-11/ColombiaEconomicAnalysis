	column Serie = SWITCH ( DimSeries[SeriesKey], "Inflation YoY", "Inflación anual", "Policy Rate", "Tasa de política", "COLCAP Monthly Return", "Rendimiento COLCAP", "Unemployment Rate", "Desempleo", "Occupation Rate", "Tasa de ocupación", "Real GDP Growth", "Crecimiento PIB real", DimSeries[SeriesKey] )
		dataType: string
		summarizeBy: none
		sortByColumn: SeriesOrder

	column Unidad = SWITCH ( DimSeries[Unit], "COP per USD", "COP por USD", "Index points", "puntos", DimSeries[Unit] )
		dataType: string
		summarizeBy: none

	partition DimSeries = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "dim_series.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"SeriesKey", type text}, {"SeriesOrder", Int64.Type}, {"Unit", type text}, {"Frequency", type text}, {"Observations", Int64.Type}, {"Mean", type number}, {"Median", type number}, {"StdDev", type number}, {"Min", type number}, {"MinPeriod", type text}, {"Max", type number}, {"MaxPeriod", type text}, {"Q1", type number}, {"Q3", type number}, {"IQR", type number}, {"LowerFence", type number}, {"UpperFence", type number}, {"OutlierCount", Int64.Type}, {"OutlierPercent", type number}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table

