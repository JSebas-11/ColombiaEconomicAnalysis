table FactMonthly
	lineageTag: 2c7190e5-6751-493b-9f37-c29fd3f4440d

	column Date
		dataType: dateTime
		isHidden
		formatString: yyyy-mm-dd
		lineageTag: d99cc46e-e9b3-43c1-aa42-2b083eac3d4b
		summarizeBy: none
		sourceColumn: Date

		annotation UnderlyingDateTimeDataType = Date

	column InflationYoY
		dataType: double
		formatString: 0.00
		lineageTag: 10211221-2905-4ffb-840a-ced3f832943b
		summarizeBy: none
		sourceColumn: InflationYoY

	column PolicyRate
		dataType: double
		formatString: 0.00
		lineageTag: 916eb880-c480-4ae4-951f-3bd1865db99e
		summarizeBy: none
		sourceColumn: PolicyRate

	column RealPolicyRate
		dataType: double
		formatString: 0.00
		lineageTag: 6def8064-bee6-4c64-9540-2a406915ccd5
		summarizeBy: none
		sourceColumn: RealPolicyRate

	column TrmAverage
		dataType: double
		formatString: #,0.00
		lineageTag: ee16769f-408b-4a55-8f44-9fbcfd2769ab
		summarizeBy: none
		sourceColumn: TrmAverage

	column TrmRebased
		dataType: double
		formatString: 0.00
		lineageTag: 95d63c6a-36bf-4d56-9b7b-fd01b8c30e45
		summarizeBy: none
		sourceColumn: TrmRebased

	column ColcapIndex
		dataType: double
		formatString: #,0.00
		lineageTag: 5c0ef26e-2df1-43be-89de-4f8865fb1fcf
		summarizeBy: none
		sourceColumn: ColcapIndex

	column ColcapRebased
		dataType: double
		formatString: 0.00
		lineageTag: 85afc18f-5148-4dbe-a40c-627ac138312b
		summarizeBy: none
		sourceColumn: ColcapRebased

	column ColcapMonthlyReturn
		dataType: double
		formatString: 0.00
		lineageTag: 15ce60eb-f8ff-44c8-ba44-a17044f384df
		summarizeBy: none
		sourceColumn: ColcapMonthlyReturn

	column UnemploymentRate
		dataType: double
		formatString: 0.00
		lineageTag: 9662f664-aba6-41ac-9717-bd0e92e3a375
		summarizeBy: none
		sourceColumn: UnemploymentRate

	column OccupationRate
		dataType: double
		formatString: 0.00
		lineageTag: bb951a7f-89ac-4485-a248-085470ca5343
		summarizeBy: none
		sourceColumn: OccupationRate

	partition FactMonthly = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "fact_monthly.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"Date", type date}, {"InflationYoY", type number}, {"PolicyRate", type number}, {"RealPolicyRate", type number}, {"TrmAverage", type number}, {"TrmRebased", type number}, {"ColcapIndex", type number}, {"ColcapRebased", type number}, {"ColcapMonthlyReturn", type number}, {"UnemploymentRate", type number}, {"OccupationRate", type number}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table

