	partition MissingDataSummary = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "missing_data_summary.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"SeriesKey", type text}, {"FirstAvailable", type text}, {"ExpectedInWindow", Int64.Type}, {"ObservedInWindow", Int64.Type}, {"EmptyInWindow", Int64.Type}, {"PreWindowGap", type text}, {"TreatmentInWindow", type text}}, "en-US")
				in
