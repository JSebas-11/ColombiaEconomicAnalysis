table CorrelationSummary
	lineageTag: 2c3116d1-23b7-443b-8de5-ad673066ec4d

	column VariableX
		dataType: string
		lineageTag: 0221b9a0-c6c9-4604-bcef-c0a264ffee86
		summarizeBy: none
		sourceColumn: VariableX

	column VariableY
		dataType: string
		lineageTag: 1e003663-455e-4690-92e8-4ad015183744
		summarizeBy: none
		sourceColumn: VariableY

	column LagMonths
		dataType: int64
		formatString: 0
		lineageTag: ca1bdb0f-45fb-4254-b0f9-629e70b9ba70
		summarizeBy: none
		sourceColumn: LagMonths

	column Correlation
		dataType: double
		formatString: 0.00
		lineageTag: 7d2275cc-8f80-461a-a647-096260b8e842
		summarizeBy: none
		sourceColumn: Correlation

	column PairedObservations
		dataType: int64
		formatString: #,0
		lineageTag: 21df715f-403f-45cd-9150-7168ccbc8f23
		summarizeBy: none
		sourceColumn: Observations

	partition CorrelationSummary = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "correlation_summary.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"VariableX", type text}, {"VariableY", type text}, {"LagMonths", Int64.Type}, {"Correlation", type number}, {"Observations", Int64.Type}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table

