				    Typed = Table.TransformColumnTypes(Promoted, {{"Date", type date}, {"Period", type text}, {"SeriesKey", type text}, {"Value", type number}, {"LowerFence", type number}, {"UpperFence", type number}, {"Direction", type text}, {"Classification", type text}, {"Treatment", type text}}, "en-US")
