table FactQuarterly
	lineageTag: 7c686e83-dd87-4f49-8160-a03cc3dd7079

	column Date
		dataType: dateTime
		isHidden
		formatString: yyyy-mm-dd
		lineageTag: 663003df-3e7d-481e-8203-a5b172c2f39c
		summarizeBy: none
		sourceColumn: Date

		annotation UnderlyingDateTimeDataType = Date

	column QuarterLabel
		dataType: string
		lineageTag: e0d97d98-2d6a-4d24-8e97-d148ca48652c
		summarizeBy: none
		sourceColumn: QuarterLabel
		sortByColumn: Date

	column RealGdpGrowth
		dataType: double
		formatString: 0.00
		lineageTag: df6ce395-6dc0-4dea-84db-6adc59baedf7
		summarizeBy: none
		sourceColumn: RealGdpGrowth

	partition FactQuarterly = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "fact_quarterly.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"Date", type date}, {"QuarterLabel", type text}, {"RealGdpGrowth", type number}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table

