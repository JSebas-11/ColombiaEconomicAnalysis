                                                                                                              ]
                                                                                             },
                                                                                             {
                                                                                                 "textRuns":  [
                                                                                                                  {
                                                                                                                      "value":  "Decisión: ",
                                                                                                                      "textStyle":  {
                                                                                                                                        "fontFamily":  "Segoe UI",
                                                                                                                                        "fontSize":  "10pt",
                                                                                                                                        "color":  "#0b0b0b",
                                                                                                                                        "fontWeight":  "bold"
                                                                                                                                    }
                                                                                                                  },
                                                                                                                  {
                                                                                                                      "value":  "se conservan los 50. Eliminarlos subestimaría el riesgo y borraría los episodios que son el objeto del análisis.",
